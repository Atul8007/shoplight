{
  "name": "shoplight",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run storefront:build && remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "remix-serve ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "storefront:build": "esbuild storefront-engine/brand-interaction.ts --bundle --minify --format=iife --target=es2020 --outfile=extensions/brand-interaction/assets/brand-interaction.js",
    "storefront:check-size": "wc -c extensions/brand-interaction/assets/brand-interaction.js"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@remix-run/node": "^2.17.0",
    "@remix-run/react": "^2.17.0",
    "@remix-run/serve": "^2.17.0",
    "@shopify/app-bridge-react": "^4.2.2",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-remix": "^4.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "isbot": "^5.1.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.0",
    "@shopify/cli": "^3.84.0",
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prisma": "^6.14.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.10"
  }
}
