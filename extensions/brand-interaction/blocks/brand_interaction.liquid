{% comment %}
  Brand Interaction Engine — App Embed Block
  This block bootstraps the lightweight storefront runtime.
  No business logic resides in Liquid — all interaction logic lives in the JS engine.
{% endcomment %}

{% if shop %}
  <script
    src="{{ 'brand-interaction.js' | asset_url }}"
    data-shop="{{ shop.permanent_domain }}"
    data-app-url="{% if block.settings.app_url != blank %}{{ block.settings.app_url }}{% else %}https://pretty-recorded-epson-cholesterol.trycloudflare.com{% endif %}"
    defer
  ></script>
{% endif %}

{% schema %}
{
  "name": "Brand Interaction",
  "target": "head",
  "javascript": "brand-interaction.js",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://pretty-recorded-epson-cholesterol.trycloudflare.com",
      "info": "The HTTPS URL of your Brand Interaction app (e.g., https://pretty-recorded-epson-cholesterol.trycloudflare.com)."
    }
  ]
}
{% endschema %}
